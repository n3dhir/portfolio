# Copy to .env and fill in. Never commit .env.
PORT=3001

# GitHub contribution calendar (server/github.js)
GITHUB_USER=n3dhir
GITHUB_TOKEN=

# Portfolio chatbot (server/chat.js) — required for /api/chat
GROQ_API_KEY=
# Optional overrides:
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
CHAT_LIMIT=50
CHAT_WINDOW_MS=900000

# Frontend analytics (Vite — must start with VITE_)
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.posthog.com
