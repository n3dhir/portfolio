# Copy to .env and fill in. Never commit .env.
PORT=3001

# GitHub contribution calendar (server/github.js)
GITHUB_USER=n3dhir
GITHUB_TOKEN=

# Portfolio chatbot (server/chat.js) — required for /api/chat
GROQ_API_KEY=
# Optional overrides:
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
CHAT_LIMIT=50
CHAT_WINDOW_MS=900000

# Frontend analytics (Vite — must start with VITE_)
VITE_GA_MEASUREMENT_ID=

# Sentry error monitoring
# Frontend (Vite — must start with VITE_)
VITE_SENTRY_DSN=
# Server (server/index.js)
SENTRY_DSN=

# Source map upload at build time (only needed where `npm run build` runs)
# Create at https://aa-nr.sentry.io/settings/auth-tokens/ — needs project:releases + org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=aa-nr
SENTRY_PROJECT=portfolio-frontend
# Optional: override the auto-generated release name (git short SHA)
SENTRY_RELEASE=
